        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите приложению показывать уведомления — иначе напоминания не появятся."
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "ערלויבט דער אַפּ צו ווײַזן מעלדונגען — אַנדערש וועלן די דערמאָנונגען נישט באַווײַזן זיך."
          }
        }
      }
    },
    "health_notif_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההתראות כבויות"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления выключены"
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "מעלדונגען זײַנען אויסגעלאָשן"
          }
        }
      }
    },
    "health_queue_text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone keeps a limited number of reminders. Open the app at least once every %1$ld days so reminders keep coming."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El iPhone guarda un número limitado de recordatorios. Abre la app al menos una vez cada %1$ld días para seguir recibiéndolos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPhone conserve un nombre limité de rappels. Ouvrez l’application au moins une fois tous les %1$ld jours pour continuer à les recevoir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האייפון שומר מספר מוגבל של תזכורות. פתחו את האפליקציה לפחות פעם ב־%1$ld ימים כדי שהתזכורות ימשיכו להגיע."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone хранит ограниченное число напоминаний. Открывайте приложение хотя бы раз в %1$ld дн., чтобы напоминания продолжали приходить."
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "דער iPhone האַלט אַ באַגרענעצטע צאָל דערמאָנונגען. עפֿנט די אַפּליקאַציע כאָטש איין מאָל אין %1$ld טעג, כּדי די דערמאָנונגען זאָלן ווײַטער קומען."
          }
        }
      }
    },
    "health_refresh_text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without it, reminders are rescheduled only when you open the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin ella, los recordatorios solo se reprograman cuando abres la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans elle, les rappels ne sont replanifiés qu’à l’ouverture de l’application."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בלעדיו התזכורות מתעדכנות רק כשפותחים את האפליקציה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без него напоминания перестраиваются только когда вы открываете приложение."
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "אָן דעם ווערן די דערמאָנונגען איבערגעשטעלט נאָר ווען איר עפֿנט די אַפּליקאַציע."
          }
        }
      }
    },
    "health_refresh_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background App Refresh is off"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización en segundo plano está desactivada"
          }
        },
        "fr": {
