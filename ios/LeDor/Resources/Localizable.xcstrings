    "about_text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is non-commercial and free. It has no ads and collects no data. The source code is open (Open Source) — anyone can check how it works and suggest improvements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no es comercial y es gratuita. No tiene publicidad ni recopila datos. El código fuente es abierto (Open Source): cualquiera puede comprobar cómo funciona y proponer mejoras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’application est non commerciale et gratuite. Elle ne contient aucune publicité et ne collecte aucune donnée. Le code source est ouvert (Open Source) — chacun peut vérifier son fonctionnement et proposer des améliorations."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה ללא מטרות רווח וחינמית. אין בה פרסומות ואין בה איסוף נתונים. קוד המקור פתוח (Open Source) — כל אחד יכול לבדוק איך היא פועלת ולהציע שיפורים."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение некоммерческое и бесплатное. В нём нет рекламы и сбора данных. Исходный код открыт (Open Source) — любой может проверить, как оно работает, и предложить улучшения."
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "די אַפּ איז נישט־קאָמערציעל און אומזיסט. אין איר איז נישטאָ קיין רעקלאַמע און קיין זאַמלען דאַטן. דער מקור־קאָד איז אָפֿן (Open Source) — יעדער קען איבערקוקן ווי זי אַרבעט און פֿאָרשלאָגן פֿאַרבעסערונגען."
          }
        }
      }
    },
