    "disconnect_text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list’s events will disappear from this phone. The list stays in the cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los eventos de la lista desaparecerán de este teléfono. En la nube la lista se conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les événements de la liste disparaîtront de ce téléphone. La liste reste dans le cloud."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אירועי הרשימה ייעלמו מטלפון זה. בענן הרשימה תישאר."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "События списка исчезнут с этого телефона. В облаке список останется."
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "די געשעענישן פֿון דער רשימה וועלן פֿאַרשווינדן פֿון דעם טעלעפֿאָן. אין וואָלקן בלײַבט די רשימה."
          }
        }
      }
    },
