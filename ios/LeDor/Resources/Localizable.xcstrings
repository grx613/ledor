          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרסה %1$@ · %2$@ · iOS %3$@. אירועים וקודי PIN לעולם אינם נשלחים."
          }
        },
        "ru": {
          "stringUnit": {
