          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "ווערסיע %1$@ · %2$@ · iOS %3$@. געשעענישן און PIN־קאָדן ווערן קיינמאָל ניט געשיקט."
          }
        }
      }
    },
    "feedback_no_network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot reach the server. Your text is kept — please try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar con el servidor. Tu texto se conserva: inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveur injoignable. Votre texte est conservé — réessayez plus tard."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין חיבור לשרת. הטקסט נשמר — נסו שוב מאוחר יותר."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет связи с сервером. Текст сохранён — попробуйте ещё раз позже."
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "קיין פֿאַרבינדונג מיטן סערווער. דער טעקסט איז אָפּגעהיט — פּרוּווט שפּעטער."
          }
        }
      }
    },
    "feedback_privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback is stored on the developer’s server for up to 2 years and is used only to reply and improve the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comentario se guarda en el servidor del desarrollador hasta 2 años y solo se usa para responder y mejorar la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’avis est conservé sur le serveur du développeur jusqu’à 2 ans et sert uniquement à répondre et à améliorer l’application."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשוב נשמר בשרת המפתח עד שנתיים ומשמש רק למענה ולשיפור האפליקציה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отзыв хранится на сервере разработчика до 2 лет и нужен только для ответа и улучшения приложения."
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "די באַמערקונג ווערט געהאַלטן אויפֿן סערווער פֿונעם אַנטוויקלער ביז 2 יאָר און ווערט גענוצט נאָר צו ענטפֿערן און פֿאַרבעסערן די אַפּ."
          }
        }
      }
    },
    "feedback_rate_limited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many messages in a row. Please try again in an hour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados mensajes seguidos. Inténtalo dentro de una hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de messages d’affilée. Réessayez dans une heure."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יותר מדי הודעות ברצף. נסו שוב בעוד שעה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много отзывов подряд. Попробуйте через час."
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "צו פֿיל באַמערקונגען נאָך אַנאַנד. פּרוּווט אין אַ שעה."
          }
        }
      }
    },
