    "sunset_hint_twilight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is twilight, between sunset and nightfall (%2$@). The date is in doubt: ask a rabbi and choose yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — crepúsculo, entre la puesta de sol y la salida de las estrellas (%2$@). La fecha es dudosa: consulta a un rabino y elige tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — crépuscule, entre le coucher du soleil et la tombée de la nuit (%2$@). La date est incertaine : consultez un rabbin et choisissez vous-même."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — בין השמשות, בין השקיעה לצאת הכוכבים (%2$@). התאריך בספק: שאלו רב ובחרו בעצמכם."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — сумерки между заходом солнца и выходом звёзд (%2$@). Дата под сомнением: посоветуйтесь с раввином и выберите сами."
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — בין־השמשות, צווישן דער שקיעה און צאת־הכּוכבֿים (%2$@). די דאַטע איז אַ ספֿק: פֿרעגט אַ רבֿ און קלײַבט אַליין."
          }
        }
      }
    },
