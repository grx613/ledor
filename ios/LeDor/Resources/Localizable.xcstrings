    "feedback_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us what is wrong or what is missing. Your feedback goes straight to the developer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntanos qué falla o qué falta. Tu comentario llega directamente al desarrollador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites-nous ce qui ne va pas ou ce qui manque. Votre avis va directement au développeur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כתבו מה לא עובד או מה חסר. המשוב מגיע ישירות למפתח."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напишите, что не так или чего не хватает. Отзыв уходит разработчику напрямую."
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "שרײַבט וואָס אַרבעט נישט אָדער וואָס פֿעלט. די באַמערקונג גייט גלײַך צום אַנטוויקלער."
          }
        }
      }
    },
