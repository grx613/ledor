          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טוב, טוב…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ладно, ладно…"
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "גוט, גוט…"
          }
        }
      }
    },
    "egg_quote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who is mighty? One who conquers his inclination."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quién es fuerte? El que domina su inclinación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui est fort ? Celui qui domine son penchant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איזהו גיבור? הכובש את יצרו."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
