    "master_share_warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Master PIN lets anyone change and delete events and the whole list. Send it only to people you fully trust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El PIN maestro permite cambiar y eliminar eventos y la lista entera. Envíalo solo a personas de plena confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code maître permet de modifier et de supprimer les événements et toute la liste. Ne l’envoyez qu’à des personnes de pleine confiance."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קוד המאסטר מאפשר לשנות ולמחוק אירועים ואת הרשימה כולה. שלחו אותו רק למי שאתם סומכים עליו לגמרי."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мастер-ПИН позволяет изменять и удалять события и весь список. Отправляйте его только тем, кому полностью доверяете."
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "דער מאַסטער־PIN לאָזט ענדערן און אויסמעקן געשעענישן און די גאַנצע רשימה. שיקט אים נאָר די, וועמען איר געטרויט אינגאַנצן."
          }
        }
      }
    },
