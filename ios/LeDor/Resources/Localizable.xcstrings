          }
        }
      }
    },
    "holidays_notify_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the time set for the evening-before reminder in Settings. No reminders on the holiday itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la hora fijada en los ajustes para el aviso de la víspera. El día de la fiesta no hay avisos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’heure définie dans les réglages pour le rappel de la veille. Aucun rappel le jour de la fête."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בשעה שנקבעה בהגדרות לתזכורת בערב שלפני. בחג עצמו אין תזכורות."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В то же время, что и напоминание накануне в настройках. В сам праздник напоминаний нет."
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "אין דער צײַט וואָס איז באַשטימט אין די אײַנשטעלונגען פֿאַר דער דערמאָנונג דעם אָוונט פֿריִער. אין יום־טובֿ אַליין זענען ניטאָ קיין דערמאָנונגען."
          }
        }
      }
    },
