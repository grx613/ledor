            "value": "Ещё пять минут"
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "נאָך פֿינף מינוט"
          }
        }
      }
    },
    "egg_excuses.5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They won’t mind"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se van a ofender"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils ne t’en voudront pas"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הם לא ייעלבו"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они не обидятся"
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "זיי וועלן זיך נישט באַליידיקן"
          }
        }
      }
    },
    "egg_excuses.6": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All right, all right…"
          }
        },
