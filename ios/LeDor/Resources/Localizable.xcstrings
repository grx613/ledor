    "pins_explain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give the regular PIN to people who will only view the list. Give the Master PIN only to those you trust to change it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da el PIN normal a quienes solo vayan a mirar. El PIN maestro, solo a quienes confíes la edición de la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez le code ordinaire à ceux qui consulteront seulement. Le code maître — uniquement à ceux à qui vous confiez la modification de la liste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "את הקוד הרגיל תנו למי שרק יצפה ברשימה. את קוד המאסטר — רק למי שאתם סומכים עליו שישנה אותה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычный ПИН дайте тем, кто будет только смотреть. Мастер-ПИН — только тем, кому доверяете изменять список."
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "דעם געוויינלעכן PIN גיט די, וואָס וועלן נאָר קוקן. דעם מאַסטער־PIN — נאָר די, וועמען איר געטרויט צו ענדערן די רשימה."
          }
        }
      }
    },
