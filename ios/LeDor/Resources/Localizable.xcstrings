    "egg_back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "He will be back. LeDor will remind you in time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volverá. LeDor te lo recordará a tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reviendra. LeDor vous le rappellera à temps."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוא עוד יחזור. LeDor יזכיר בזמן."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он ещё вернётся. А LeDor напомнит вовремя."
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "ער וועט נאָך צוריקקומען. LeDor וועט דערמאָנען אין צײַט."
          }
        }
      }
    },
    "egg_excuses.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call them tomorrow"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya llamarás mañana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu appelleras demain"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תתקשרו מחר"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позвонишь завтра"
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "איר וועט מאָרגן אָנקלינגען"
          }
        }
      }
    },
    "egg_excuses.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Congratulate them later"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya felicitarás luego"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu féliciteras plus tard"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תברכו אחר כך"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поздравишь потом"
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "איר וועט שפּעטער ווינטשן"
          }
        }
      }
    },
    "egg_excuses.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light the candle later"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vela, ya la encenderás"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bougie, tu l’allumeras plus tard"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "את הנר תדליקו אחר כך"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свечу зажжёшь позже"
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "דאָס ליכט וועט איר שפּעטער אָנצינדן"
          }
        }
      }
    },
    "egg_excuses.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who remembers these dates anyway"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quién se acuerda de esas fechas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui se souvient de ces dates ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מי בכלל זוכר תאריכים"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Да кто помнит эти даты"
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "ווער געדענקט דען די דאַטעס"
          }
        }
      }
    },
    "egg_excuses.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five more minutes"
          }
        },
