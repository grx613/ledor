            "state": "translated",
            "value": "L’actualisation en arrière-plan est désactivée"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רענון ברקע כבוי"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновление контента в фоне выключено"
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "הינטערגרונט־דערפֿרישונג איז אויסגעלאָשן"
          }
        }
      }
    },
