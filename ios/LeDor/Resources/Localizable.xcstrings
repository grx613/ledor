    "empty_events": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No events yet. Add the first one: a birthday, a yahrzeit or a family celebration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay eventos. Añade el primero: un cumpleaños, un yahrzeit o una celebración familiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d’événements. Ajoutez le premier : un anniversaire, une yahrzeit ou une fête de famille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין אירועים. הוסיפו את הראשון: יום הולדת, יארצייט או שמחה משפחתית."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет событий. Добавьте первое — день рождения, йорцайт или семейный праздник."
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "נאָך קיין געשעענישן. לייגט צו די ערשטע: אַ געבורטסטאָג, אַ יאָרצײַט אָדער אַ משפּחה־שׂימחה."
          }
        }
      }
    },
