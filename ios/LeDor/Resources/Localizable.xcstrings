        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre avis a été reçu. Si vous avez laissé un contact, je vous répondrai."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשוב התקבל. אם השארתם פרטי קשר, אענה."
