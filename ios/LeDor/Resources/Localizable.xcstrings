    "sunset_hint_after": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is after sunset: the Hebrew date is already the next one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — después de la puesta de sol: la fecha hebrea ya es la siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — après le coucher du soleil : la date hébraïque est déjà la suivante."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — אחרי השקיעה: התאריך העברי הוא כבר הבא."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — после захода: еврейская дата уже следующая."
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — נאָך דער שקיעה: די ייִדישע דאַטע איז שוין די קומענדיקע."
          }
        }
      }
    },
