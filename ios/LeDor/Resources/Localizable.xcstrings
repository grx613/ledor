        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "דער ייִדישער טאָג הייבט זיך אָן דעם פֿריִערדיקן אָוונט, מיט דער שקיעה %1$@."
          }
        }
      }
    },
