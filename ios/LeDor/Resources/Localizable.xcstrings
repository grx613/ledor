    "share_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "📅 The list “%1$@” in the %2$@ app: birthdays, yahrzeits and family events by the Hebrew and Gregorian calendars.\n\n1. Install the app: %3$@\n2. Open “Lists” → “Connect a list”\n3. Name: %4$@\n4. PIN: %5$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "📅 La lista «%1$@» en la app %2$@: cumpleaños, yahrzeits y eventos familiares según los calendarios hebreo y gregoriano.\n\n1. Instala la app: %3$@\n2. Abre «Listas» → «Conectar una lista»\n3. Nombre: %4$@\n4. PIN: %5$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "📅 La liste « %1$@ » dans l’application %2$@ : anniversaires, yahrzeits et événements familiaux selon les calendriers hébraïque et grégorien.\n\n1. Installez l’application : %3$@\n2. Ouvrez « Listes » → « Connecter une liste »\n3. Nom : %4$@\n4. Code PIN : %5$@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "📅 הרשימה „%1$@” באפליקציה %2$@: ימי הולדת, יארצייטים ואירועים משפחתיים לפי הלוח העברי והלועזי.\n\n1. התקינו את האפליקציה: %3$@\n2. פתחו „רשימות” ← „חיבור רשימה”\n3. שם: %4$@\n4. קוד PIN: %5$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "📅 Список «%1$@» в приложении %2$@: дни рождения, йорцайты и семейные события по еврейскому и обычному календарю.\n\n1. Установите приложение: %3$@\n2. Откройте «Списки» → «Подключить список»\n3. Название: %4$@\n4. ПИН-код: %5$@"
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "📅 די רשימה „%1$@“ אין דער אַפּ %2$@: געבורטסטעג, יאָרצײַטן און משפּחה־געשעענישן לויטן ייִדישן און גרעגאָריאַנישן לוח.\n\n1. אינסטאַלירט די אַפּ: %3$@\n2. עפֿנט „רשימות“ ← „פֿאַרבינדן אַ רשימה“\n3. נאָמען: %4$@\n4. PIN: %5$@"
          }
        }
      }
    },
