    "join_explain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the list name, then the PIN. Either the regular PIN (read only) or the Master PIN (editing) works."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el nombre de la lista y después el PIN. Sirve tanto el PIN normal (solo lectura) como el PIN maestro (edición)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le nom de la liste, puis le code PIN. Le code ordinaire (lecture seule) comme le code maître (modification) conviennent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזינו את שם הרשימה ואחר כך את הקוד. מתאים גם הקוד הרגיל (קריאה בלבד) וגם קוד המאסטר (עריכה)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите название списка, а затем ПИН-код. Подойдёт и обычный ПИН (только чтение), и Мастер-ПИН (редактирование)."
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "שרײַבט אַרײַן דעם נאָמען פֿון דער רשימה און דערנאָך דעם PIN. עס פּאַסט סײַ דער געוויינלעכער PIN (נאָר לייענען), סײַ דער מאַסטער־PIN (רעדאַקטירן)."
          }
        }
      }
    },
