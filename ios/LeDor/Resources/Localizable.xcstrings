    "sunset_hint_local": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local time, as the clock showed then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hora local, la que marcaba el reloj entonces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heure locale, telle qu’affichée à l’époque."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שעה מקומית, כפי שהראה אז השעון."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время — местное, как было на часах."
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "אָרטיקע צײַט, ווי דער זייגער האָט דעמאָלט געוויזן."
          }
        }
      }
    },
    "sunset_hint_none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun does not set in this city on this day. Ask a rabbi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese día el sol no se pone en esta ciudad. Consulta a un rabino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce jour-là, le soleil ne se couche pas dans cette ville. Consultez un rabbin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביום זה השמש אינה שוקעת בעיר זו. שאלו רב."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этот день солнце в этом городе не заходит. Посоветуйтесь с раввином."
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "אין דעם טאָג גייט די זון נישט אונטער אין דער שטאָט. פֿרעגט אַ רבֿ."
          }
        }
      }
    },
    "sunset_hint_open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sure? Get a hint from the time and city"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No lo sabes? Te ayudo con la hora y la ciudad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne savez pas ? Aide d’après l’heure et la ville"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא בטוחים? נעזור לפי השעה והעיר"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не знаете? Подскажу по времени и городу"
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "ניט זיכער? מיר וועלן העלפֿן לויט דער צײַט און שטאָט"
          }
        }
      }
    },
