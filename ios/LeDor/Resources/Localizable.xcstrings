    "delete_cloud_text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list and all its events will be permanently deleted for every member. Enter the Master PIN to confirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista y todos sus eventos se eliminarán para siempre para todos los miembros. Introduce el PIN maestro para confirmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste et tous ses événements seront supprimés définitivement pour tous les membres. Saisissez le code maître pour confirmer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרשימה וכל אירועיה יימחקו לצמיתות אצל כל המשתתפים. הזינו את קוד המאסטר לאישור."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список и все его события будут удалены безвозвратно у всех участников. Введите Мастер-ПИН для подтверждения."
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "די רשימה מיט אַלע אירע געשעענישן וועט אויף אייביק אויסגעמעקט ווערן בײַ אַלע באַטייליקטע. שרײַבט אַרײַן דעם מאַסטער־PIN צו באַשטעטיקן."
          }
        }
      }
    },
    "delete_event_q": {
      "extractionState": "manual",
      "localizations": {
