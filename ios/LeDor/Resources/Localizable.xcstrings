    "personal_list_explain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The personal list is stored only on this phone and is never sent anywhere. To share events with your family, create a cloud list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista personal se guarda solo en este teléfono y no se envía a ningún sitio. Para compartir eventos con tu familia, crea una lista en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste personnelle est conservée uniquement sur ce téléphone et n’est envoyée nulle part. Pour partager des événements avec vos proches, créez une liste dans le cloud."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרשימה האישית נשמרת רק בטלפון זה ואינה נשלחת לשום מקום. כדי לשתף אירועים עם המשפחה, צרו רשימה בענן."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Личный список хранится только на этом телефоне и никуда не отправляется. Чтобы делиться событиями с родными, создайте облачный список."
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "די פּערזענלעכע רשימה ווערט געהאַלטן נאָר אויף דעם טעלעפֿאָן און ווערט ניט געשיקט ערגעץ. כּדי צו טיילן געשעענישן מיט דער משפּחה, שאַפֿט אַ רשימה אין וואָלקן."
          }
        }
      }
    },
