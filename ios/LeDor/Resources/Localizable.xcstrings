    "feedback_meta_detail_ios": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %1$@ · %2$@ · iOS %3$@. Events and PINs are never sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Versión %1$@ · %2$@ · iOS %3$@. Los eventos y los PIN nunca se envían."
