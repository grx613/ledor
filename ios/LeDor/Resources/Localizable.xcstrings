    "err_cloud_not_configured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cloud is not configured in this build: shared lists cannot be created or connected. The personal list works fully."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La nube no está configurada en esta versión: no se pueden crear ni conectar listas compartidas. La lista personal funciona por completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cloud n’est pas configuré dans cette version : impossible de créer ou de connecter des listes partagées. La liste personnelle fonctionne entièrement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הענן אינו מוגדר בגרסה זו: אי אפשר ליצור או לחבר רשימות משותפות. הרשימה האישית פועלת במלואה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Облако пока не настроено в этой сборке: создавать и подключать общие списки нельзя. Личный список работает полностью."
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "דער וואָלקן איז נישט אײַנגעשטעלט אין דער ווערסיע: מע קען נישט שאַפֿן אָדער פֿאַרבינדן געמיינזאַמע רשימות. די פּערזענלעכע רשימה אַרבעט אינגאַנצן."
          }
        }
      }
    },
