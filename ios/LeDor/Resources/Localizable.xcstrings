    "licenses_text_ios": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubik font — SIL Open Font License 1.1\nThe Hebrew calendar and sunset times are calculated by the app’s own code; no third-party libraries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuente Rubik — SIL Open Font License 1.1\nEl calendario hebreo y las horas de la puesta del sol se calculan con el propio código de la app, sin bibliotecas de terceros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Police Rubik — SIL Open Font License 1.1\nLe calendrier hébraïque et les heures du coucher du soleil sont calculés par le code de l’application, sans bibliothèque tierce."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גופן Rubik — SIL Open Font License 1.1\nהלוח העברי וזמני השקיעה מחושבים בקוד של האפליקציה עצמה, ללא ספריות צד שלישי."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шрифт Rubik — SIL Open Font License 1.1\nЕврейский календарь и время захода считает собственный код приложения; сторонних библиотек нет."
          }
        },
        "yi": {
          "stringUnit": {
            "state": "translated",
            "value": "שריפֿט Rubik — SIL Open Font License 1.1\nדער ייִדישער קאַלענדאַר און די זונפֿאַרגאַנג־צײַטן ווערן אויסגערעכנט מיטן אייגענעם קאָד פֿון דער אַפּליקאַציע; קיין פֿרעמדע ביבליאָטעקן."
          }
        }
      }
    },
